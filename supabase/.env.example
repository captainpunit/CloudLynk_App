# Server secrets: set with `supabase secrets set --env-file supabase/.env`. Never ship in the app.
ANDROID_PACKAGE_NAME=com.cloudlynk.app
# Service account JSON (Play Console > API access) with "View financial data" permission.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Pub/Sub push subscription audience used to verify RTDN calls.
RTDN_PUSH_AUDIENCE=
# Exact service account email selected on the authenticated Pub/Sub push subscription.
RTDN_SERVICE_ACCOUNT_EMAIL=

# Meta Conversions API (client's Meta Business account)
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=
# Optional: Events Manager test code while testing; leave empty in production.
META_TEST_EVENT_CODE=

CRON_SECRET=

# Cloudflare: Stream (video) and R2. Server only, never in the app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
