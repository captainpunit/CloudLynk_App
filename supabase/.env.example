# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase itself; do not set them.
# Server secrets: set with `supabase secrets set --env-file supabase/.env`. Never ship in the app.
ANDROID_PACKAGE_NAME=com.cloudlynk.app
# Service account JSON (Play Console > API access) with "View financial data" and "Manage orders and subscriptions" permissions.
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
# Only for auto-renewing Play subscriptions (play-rtdn-webhook); the launch plans are
# one-time products and do not use it. Pub/Sub push subscription audience for RTDN calls.
RTDN_PUSH_AUDIENCE=
# Exact service account email selected on the authenticated Pub/Sub push subscription.
RTDN_SERVICE_ACCOUNT_EMAIL=

# Meta Conversions API (client's Meta Business account)
META_DATASET_ID=
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=
# Optional: Events Manager test code while testing; leave empty in production.
META_TEST_EVENT_CODE=

CRON_SECRET=

# Cloudflare Stream (video). Server only, never in the app.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_WEBHOOK_SECRET=
# Stream signing-key ID and the base64-encoded JWK returned by Cloudflare's keys API.
CLOUDFLARE_STREAM_SIGNING_KEY_ID=
CLOUDFLARE_STREAM_SIGNING_JWK_BASE64=
# Host only, for example customer-xxxx.cloudflarestream.com (no scheme/path).
CLOUDFLARE_STREAM_PLAYBACK_HOST=
# Deployment limits; choose these to match the client's publishing allowance.
STREAM_MAX_UPLOAD_BYTES=10737418240
STREAM_MAX_DURATION_SECONDS=14400
# Optional Expo enhanced push security access token. Configure FCM v1 in Expo/EAS.
EXPO_ACCESS_TOKEN=
