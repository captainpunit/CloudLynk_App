{
  "name": "cloudlynk-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "doctor": "npx expo-doctor",
    "test": "node --import tsx --test src/domain/__tests__/access.test.ts src/state/__tests__/workspace-reducer.test.ts src/services/billing/__tests__/purchase-policy.test.ts src/services/account/__tests__/deletion-flow.test.ts src/data/live/__tests__/mapping.test.ts src/services/uploads/__tests__/tus.test.ts",
    "test:api": "node --import tsx scripts/check-live-api.ts",
    "format": "prettier --write app src plugins app.config.ts tsconfig.json react-native.config.js",
    "format:check": "prettier --check app src plugins app.config.ts tsconfig.json react-native.config.js",
    "web": "expo start --web",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.117.3",
    "expo": "~57.0.28",
    "expo-build-properties": "~57.0.22",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-font": "~57.0.4",
    "expo-iap": "^6.0.1",
    "expo-image": "~57.0.5",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.12",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "lucide-react-native": "^1.61.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-play-install-referrer": "^2.0.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3"
  }
}
