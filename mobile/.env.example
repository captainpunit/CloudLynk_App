# Public values only. Anything here is bundled into the app.
EXPO_PUBLIC_NATIVE_INTEGRATIONS=false
EXPO_PUBLIC_EAS_PROJECT_ID=
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=
EXPO_PUBLIC_ANDROID_PACKAGE=com.cloudlynk.app
EXPO_PUBLIC_APP_SCHEME=cloudlynk
# Host for shared https links and Android App Links. Empty = app-scheme links only.
EXPO_PUBLIC_APP_LINK_HOST=cloudlynk.app
# Public https pages shown at sign-up, checkout and in Settings. Google Play requires a privacy policy.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=

# Meta SDK (from the Meta App Dashboard of the CLIENT's Meta app)
META_APP_ID=
META_CLIENT_TOKEN=
META_DISPLAY_NAME=CloudLynk
