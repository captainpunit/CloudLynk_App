+// CloudLynk: how far each player's subtitles are lifted (dp), re-applied when the view is
+// resized, for example on entering or leaving picture-in-picture.
+private val cloudlynkSubtitleInsets = java.util.WeakHashMap<androidx.media3.ui.PlayerView, Float>()
+
+private fun cloudlynkApplySubtitleInset(playerView: androidx.media3.ui.PlayerView) {
+  val subtitles = playerView.subtitleView ?: return
+  val density = playerView.resources.displayMetrics.density
+  // A small window (picture-in-picture) shows none of the app's controls, so its subtitles
+  // stay at the bottom.
+  val inset = if (playerView.height < 180 * density) 0f else cloudlynkSubtitleInsets[playerView] ?: 0f
+  val px = (inset * density).toInt()
+  if (subtitles.paddingBottom != px) {
+    // Posted: padding changes inside a layout pass would be dropped.
+    subtitles.post {
+      subtitles.setPadding(subtitles.paddingLeft, subtitles.paddingTop, subtitles.paddingRight, px)
+    }
+  }
+}
